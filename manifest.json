{
  "name": "NoFishInThisPond",
  "description": "Extensão para proteger sua navegação contra phishing",
  "version": "1.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "js": ["script/Analise.js"],
      "css": ["styles.css"],
      "matches": ["<all_urls>"],
      "run_at": "document_end" 
    }
  ],
  "action": {
    "default_popup": "alert.html",
    "default_icon": "icone.png"
  }
}